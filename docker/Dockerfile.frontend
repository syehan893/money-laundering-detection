# ── Frontend Dockerfile (Next.js) ──
# Build context: project root (money-laundering-detection/)
#
# Frontend Vite lama di `frontend/` sudah dihapus; dashboard sekarang
# `frontend-next/` (Next.js 15). Next.js di sini TIDAK bisa diekspor menjadi
# berkas statis lalu disajikan nginx, karena `next.config.mjs` memakai
# `rewrites()` untuk mem-proksi /api ke FastAPI. Rewrite itu dijalankan server
# Next saat request datang, jadi imagenya harus menjalankan `next start`.

# Stage 1: Build
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend-next/package.json frontend-next/package-lock.json ./
RUN npm ci --silent

COPY frontend-next/ .
RUN npm run build

# Stage 2: Runtime
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Hanya dependensi produksi yang ikut ke image akhir
COPY frontend-next/package.json frontend-next/package-lock.json ./
RUN npm ci --omit=dev --silent

COPY --from=build /app/.next ./.next
COPY --from=build /app/next.config.mjs ./

EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]

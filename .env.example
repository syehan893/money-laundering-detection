# ══════════════════════════════════════════════════════════════════
#  AML Guard — Environment Variables
# ══════════════════════════════════════════════════════════════════
#  Copy this file to .env and fill in the values:
#    cp .env.example .env
# ══════════════════════════════════════════════════════════════════

# ── MongoDB ──
# Local development: no authentication required (docker-compose.mongodb.yml)
# For production, enable auth and update MONGO_URL accordingly.
MONGO_USER=admin
MONGO_PASS=admin123
MONGO_DB=money-laundering-detection
MONGO_PORT=27017

# Connection string untuk local development (tanpa auth)
MONGO_URL=mongodb://localhost:27017/money-laundering-detection

# ── Backend ──
BACKEND_PORT=8000

# ── Frontend ──
FRONTEND_PORT=80
